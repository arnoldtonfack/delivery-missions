# ─── Application ────────────────────────────────────────────────────────────
APP_NAME="Delivery Missions API"
NODE_ENV=development
PORT=3000
# Origines autorisées, séparées par des virgules. Obligatoire en production.
# En dev, laisser vide autorise toutes les origines (ex. front Next.js sur :3001).
CORS_ORIGIN=http://localhost:3001

# ─── PostgreSQL ─────────────────────────────────────────────────────────────
DB_USER=delivery
DB_PASSWORD=delivery
DB_NAME=delivery_missions
DB_PORT=5440
# Exécution sur l'hôte (`pnpm dev`) : Postgres publié sur localhost.
# Dans docker compose, `app`/`migrate` surchargent cette valeur (hôte `postgres`).
DATABASE_URL=postgresql://delivery:delivery@localhost:5440/delivery_missions?schema=public
# Optionnel : connexion directe pour les migrations si DATABASE_URL passe par un pooler.
# DIRECT_DATABASE_URL=

# ─── Redis (cache applicatif + BullMQ) ──────────────────────────────────────
# Ports publiés volontairement non standards (5440/6390) pour cohabiter avec
# d'autres projets locaux. Dans docker compose, `app` surcharge avec redis:6379.
REDIS_HOST=localhost
REDIS_PORT=6390
REDIS_HOST_PORT=6390
REDIS_PASSWORD=delivery
REDIS_MAX_MEMORY=256mb
# TTL par défaut du cache, en secondes.
REDIS_TTL=300

# ─── Authentification (JWT) ─────────────────────────────────────────────────
# Secret de signature des jetons — OBLIGATOIRE. Générer : `openssl rand -hex 32`.
JWT_SECRET=change-me-dev-only-secret
# Durée de vie du jeton d'accès, en secondes (28800 = 8 h, une journée de tournée).
JWT_EXPIRES_IN_SECONDS=28800

# ─── Déploiement ────────────────────────────────────────────────────────────
# `true` : l'entrypoint Docker applique `prisma migrate deploy` avant de démarrer
# (utile sur Render & co. sans job de migration séparé).
RUN_MIGRATIONS=false
# docker-compose.prod.yml (serveur partagé) : PORT = port publié de l'API sur
# l'hôte, CORS_ORIGIN = URL du front (ex. http://<ip>:<port-web>), et des
# DB_PASSWORD / REDIS_PASSWORD forts (ex. `openssl rand -hex 24`).
# DB_PORT / REDIS_HOST_PORT y sont ignorés : Postgres et Redis ne sont pas publiés.
# DOCKER_SUBNET : sous-réseau libre du réseau interne (obligatoire avec
# docker-compose.prod.yml), ex. 172.16.78.0/24.
# DOCKER_SUBNET=
